<!DOCTYPE html>
<html lang="en" class="scroll-smooth" data-theme="warm-atelier">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AAICA Modular Kitchen | Direct Factory Manufacturer Delhi NCR</title>
  <meta name="description" content="Thoughtful modular kitchens and bespoke wardrobes crafted directly at our Jagat Puri factory. 100% BWP Marine Ply, German hardware, zero showroom markups.">
  
  <!-- Fonts: Modern Poppins (Bold, Crisp Sans-Serif) & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            heading: ['"Poppins"', 'system-ui', 'sans-serif'],
            poppins: ['"Poppins"', 'system-ui', 'sans-serif'],
            serif: ['"Poppins"', 'system-ui', 'sans-serif'], // Maps legacy serif classes to Poppins so NO cursive text renders!
          },
          colors: {
            linen: {
              50: '#FDFCF9',
              100: '#F8F6F0',
              200: '#F0ECE1',
              300: '#E4DCD0',
              400: '#CFC3B1',
            },
            terracotta: {
              500: '#C25E34',
              600: '#A34B24',
              700: '#843A1A',
            },
            gold: {
              400: '#F59E0B',
              500: '#D97706',
              600: '#B45309',
            },
            ink: {
              950: '#0F0E0D',
              900: '#1A1816',
              800: '#2C2724',
              700: '#463F3A',
              500: '#756D65',
              400: '#A89F95',
            }
          }
        }
      }
    }
  </script>
  
  <style>
    ::selection {
      background-color: #F59E0B;
      color: #0F0E0D;
    }
    .editorial-border {
      border-color: #E6DFD5;
    }
    .badge-number {
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.1em;
    }
    .bg-subtle-pattern {
      background-color: #F8F6F0;
      background-image: radial-gradient(rgba(194, 94, 52, 0.05) 1px, transparent 0);
      background-size: 32px 32px;
    }
    /* 2. Hero Section (AtoZ Style Smooth Horizontal Slide Carousel - Clean & Minimal) */
    .hero-slider {
      position: relative;
      width: 100%;
      height: calc(100vh - 80px);
      min-height: 720px;
      max-height: 940px;
      overflow: hidden;
      background: #0d0c0b;
    }
    .hero-track {
      display: flex;
      width: 400%;
      height: 100%;
      transition: transform 1.2s cubic-bezier(0.65, 0, 0.35, 1);
      will-change: transform;
    }
    .hero-slide {
      position: relative;
      width: 25%;
      height: 100%;
      flex-shrink: 0;
      overflow: hidden;
    }
    .hero-slide-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      transform: scale(1);
      transition: transform 7s cubic-bezier(0.25, 1, 0.5, 1);
      will-change: transform;
    }
    .hero-slide.active .hero-slide-bg {
      transform: scale(1.08);
    }
    .hero-slide-overlay {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, rgba(10, 9, 8, 0.35) 0%, rgba(10, 9, 8, 0.75) 100%),
                  linear-gradient(0deg, rgba(10, 9, 8, 0.65) 0%, transparent 40%);
      pointer-events: none;
      z-index: 15;
    }
    .hero-text-centered {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0 1.5rem;
      z-index: 25;
      max-width: 980px;
      margin: 0 auto;
    }
    .hero-text-centered .anim-eyebrow,
    .hero-text-centered h1,
    .hero-text-centered .hero-single-btn {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hero-slide.active .hero-text-centered .anim-eyebrow {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.15s;
    }
    .hero-slide.active .hero-text-centered h1 {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.3s;
    }
    .hero-slide.active .hero-text-centered .hero-single-btn {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.45s;
    }
    /* AtoZ Style Outline Glass Button */
    .atoz-btn {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      padding: 14px 28px;
      border-radius: 9999px;
      border: 1px solid rgba(255, 255, 255, 0.35);
      background: rgba(0, 0, 0, 0.25);
      backdrop-filter: blur(12px);
      color: #ffffff;
      font-family: 'Poppins', sans-serif;
      font-weight: 700;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      transition: all 0.35s ease;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      cursor: pointer;
    }
    .atoz-btn:hover {
      background: rgba(255, 255, 255, 0.15);
      border-color: #f59e0b;
      color: #ffffff;
      transform: scale(1.05);
      box-shadow: 0 12px 36px rgba(245, 158, 11, 0.25);
    }
    .atoz-btn .btn-arrow-circle {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #8C7756;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      transition: all 0.3s ease;
    }
    .atoz-btn:hover .btn-arrow-circle {
      background: #f59e0b;
      transform: rotate(45deg);
    }
    /* Sticky Side Tab for Free Quote */
    .sticky-quote-tab {
      position: fixed;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      z-index: 45;
      background: #ff1d25;
      color: #ffffff;
      font-family: 'Poppins', sans-serif;
      font-weight: 800;
      font-size: 11px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 14px 7px;
      border-top-left-radius: 12px;
      border-bottom-left-radius: 12px;
      box-shadow: -4px 4px 20px rgba(0, 0, 0, 0.3);
      writing-mode: vertical-rl;
      transform: translateY(-50%) rotate(180deg);
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .sticky-quote-tab:hover {
      background: #e0121a;
      padding-right: 12px;
    }
    /* Smooth Accordion */
    .accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
      opacity: 0;
    }
    .accordion-item.active .accordion-content {
      max-height: 500px;
      opacity: 1;
    }
    .accordion-item.active .accordion-icon {
      transform: rotate(45deg);
    }
    /* Minimal Estimator Interactive Buttons */
    .calc-layout-btn, .calc-finish-btn, .calc-scale-btn {
      border-color: #e7e5e4;
      background-color: #fafaf9;
      color: #1c1917;
      cursor: pointer;
    }
    .calc-layout-btn:hover, .calc-finish-btn:hover, .calc-scale-btn:hover {
      border-color: #a8a29e;
      background-color: #f5f5f4;
    }
    .calc-layout-btn.active, .calc-finish-btn.active, .calc-scale-btn.active {
      border-color: #1c1917;
      background-color: #1c1917;
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    }
    .calc-layout-btn.active .text-stone-400,
    .calc-finish-btn.active .text-stone-400,
    .calc-scale-btn.active .text-stone-400 {
      color: #a8a29e;
    }
    /* Infinite Marquee Track (Wonder Interior Style) */
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .marquee-track {
      display: flex;
      gap: 1.25rem;
      width: max-content;
      animation: marquee 28s linear infinite;
      will-change: transform;
    }
    .marquee-track:hover {
      animation-play-state: paused;
    }
    /* AtoZ Style Outline Watermark & Marquee */
    .text-stroke-watermark {
      font-size: clamp(80px, 14vw, 170px);
      line-height: 1;
      font-weight: 900;
      color: transparent;
      -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.08);
      user-select: none;
      pointer-events: none;
    }
    .text-stroke-marquee {
      font-size: clamp(40px, 5.5vw, 76px);
      font-weight: 800;
      color: transparent;
      -webkit-text-stroke: 1px rgba(168, 159, 149, 0.35);
      white-space: nowrap;
      user-select: none;
    }
    @keyframes marqueeOutline {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .marquee-outline-track {
      display: flex;
      gap: 2.5rem;
      width: max-content;
      animation: marqueeOutline 25s linear infinite;
      will-change: transform;
    }
    .marquee-outline-track:hover {
      animation-play-state: paused;
    }
    /* Moving Testimonials Track (Smooth Infinite Auto-Scroll) */
    @keyframes testimonialSlide {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .testimonials-slide-track {
      display: flex;
      gap: 1.5rem;
      width: max-content;
      animation: testimonialSlide 38s linear infinite;
      will-change: transform;
    }
    .testimonials-slide-track:hover {
      animation-play-state: paused;
    }
  </style>
</head>
<body class="bg-linen-100 text-ink-900 font-sans antialiased pb-24 lg:pb-0 selection:bg-amber-100">

  <!-- Floating Sticky Side Tab (Woodspace Style FREE QUOTE) -->
  <a href="https://wa.me/919910270754?text=Hi%20AAICA%20Kitchen,%20I%20want%20to%20get%20a%20Free%203D%20Kitchen%20Design%20Quote." 
     target="_blank" 
     class="sticky-quote-tab hidden sm:flex items-center justify-center gap-1 group" onclick="openInquiryModal()"
     title="Get Free 3D Design Quote">
    <span>💬 FREE QUOTE</span>
  </a>

  <!-- Main Navigation Header (Clean, Crisp White, Spacious & Modern) -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-stone-200 text-stone-900 transition-all duration-300 shadow-sm">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 h-20 sm:h-22 flex items-center justify-between">
      
      <!-- Brand Logo + Direct Phone Pill -->
      <div class="flex items-center gap-4 sm:gap-6 flex-shrink-0">
        <a href="#" class="flex items-center group py-1">
          <img src="assets/aaica-original-logo.png" 
               alt="AAICA Bath N Kitchen" 
               class="h-10 sm:h-12 w-auto object-contain transition duration-200 group-hover:scale-102">
        </a>
        <a href="tel:+919910270754" class="hidden xl:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-800 text-xs font-heading font-extrabold tracking-wider transition">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>+91 99102 70754</span>
        </a>
      </div>

      <!-- Desktop Nav (Clean, Spacious, Essential Links) -->
      <nav class="hidden lg:flex items-center gap-5 xl:gap-7 text-xs font-heading font-extrabold uppercase tracking-wider text-stone-700">
        <a href="#about" class="hover:text-[#ff1d25] transition py-1.5 whitespace-nowrap">About</a>
        <a href="#services" class="hover:text-[#ff1d25] transition py-1.5 whitespace-nowrap">Services</a>
        <a href="#why-us" class="hover:text-[#ff1d25] transition py-1.5 whitespace-nowrap">Why Us</a>
