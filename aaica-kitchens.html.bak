            </button>
          </div>
        </div>
      </div>

      <!-- Slide 4: GERMAN CNC FABRICATION -->
      <div class="hero-slide">
        <div class="hero-slide-bg" style="background-image: url('https://images.unsplash.com/photo-1507089947368-19c1da9775ae?auto=format&fit=crop&w=2000&q=85');"></div>
        <div class="hero-slide-overlay"></div>
        <div class="hero-text-centered">
