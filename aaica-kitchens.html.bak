        <a href="#reviews" class="hover:text-[#ff1d25] transition py-1.5 whitespace-nowrap">Reviews</a>
        <a href="#contact" class="hover:text-[#ff1d25] transition py-1.5 whitespace-nowrap">Contact</a>
      </nav>

      <!-- Header CTAs & Mobile Toggle -->
      <div class="flex items-center gap-3 sm:gap-4 flex-shrink-0">
        <!-- Direct Free Quote Pill Button -->
        <button onclick="openInquiryModal()" class="inline-flex items-center gap-2 bg-[#ff1d25] hover:bg-[#d91219] text-white px-6 sm:px-7 py-3 rounded-full text-xs font-heading font-bold uppercase tracking-wider shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5">
          <span>Get Free Quote</span>
          <span class="text-sm">↗</span>
        </button>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-toggle" class="lg:hidden p-2.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-900 transition focus:outline-none" aria-label="Toggle Navigation">
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

    </div>

    <!-- Mobile Slide-Down Menu -->
    <div id="mobile-menu-dropdown" class="hidden lg:hidden bg-white border-b border-stone-200 px-6 py-6 space-y-4 shadow-xl">
      <div class="space-y-3 text-sm font-heading font-bold uppercase tracking-wider text-stone-900">
        <a href="#about" class="block hover:text-[#ff1d25] py-1 transition mobile-nav-link">About Atelier</a>
        <a href="#services" class="block hover:text-[#ff1d25] py-1 transition mobile-nav-link">Services &amp; Joinery</a>
        <a href="#why-us" class="block hover:text-[#ff1d25] py-1 transition mobile-nav-link">Why Choose Us</a>
        <a href="#portfolio" class="block hover:text-[#ff1d25] py-1 transition mobile-nav-link">Real Projects Gallery</a>
        <a href="#comparison" class="block hover:text-[#ff1d25] py-1 transition mobile-nav-link">Factory Advantage vs Retail</a>
        <a href="#calculator" class="block hover:text-[#ff1d25] py-1 transition mobile-nav-link">Instant Cost Estimator</a>
        <a href="#reviews" class="block hover:text-[#ff1d25] py-1 transition mobile-nav-link">Client Reviews</a>
        <a href="#contact" class="block hover:text-[#ff1d25] py-1 transition mobile-nav-link">Book Free Workshop Visit</a>
      </div>
    </div>
  </header>

  <section class="hero-slider relative text-white border-b border-stone-800 overflow-hidden">

    <div class="hero-track">
      <!-- Slide 1: MODULAR KITCHEN -->
      <div class="hero-slide active">
