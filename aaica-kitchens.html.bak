  <!-- 01 / About & Partner: Your Trusted Interior Design Partner (AtoZ Style Frame 01) -->
  <section id="about" class="py-20 md:py-28 bg-white border-b border-stone-200">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Big Rounded Image with Overlapping Award Badge -->
        <div class="lg:col-span-6 relative">
          <div class="rounded-3xl overflow-hidden shadow-2xl border border-stone-200 aspect-[4/3] relative">
            <img src="https://images.unsplash.com/photo-1507089947368-19c1da9775ae?auto=format&fit=crop&w=1200&q=85" 
                 alt="AAICA Atelier Team" 
                 class="w-full h-full object-cover">
          </div>
          
          <!-- Overlapping Gold/Bronze Badge (AtoZ Frame 01) -->
          <div class="absolute -bottom-6 -right-2 sm:bottom-6 sm:right-6 bg-[#8C7756] text-white p-5 sm:p-6 rounded-2xl shadow-2xl border border-[#A6906D] flex items-center gap-3.5 max-w-[220px]">
            <div class="text-3xl sm:text-4xl">🏆</div>
            <div>
              <div class="text-[11px] font-heading font-extrabold uppercase tracking-wider text-amber-200">Certified Atelier</div>
              <div class="text-xs sm:text-sm font-heading font-black leading-tight text-white mt-0.5">Best Awarded Kitchen Atelier</div>
            </div>
          </div>
        </div>

        <!-- Right Column: Editorial Copy & 4 Rounded Feature Pills -->
        <div class="lg:col-span-6 space-y-6 lg:pl-4">
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-heading font-extrabold tracking-widest text-[#8C7756] uppercase mb-2">
              <span class="w-2 h-2 rounded-full bg-[#8C7756]"></span>
              <span>SINCE 2012</span>
            </div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-stone-900 leading-tight tracking-tight">
              Your Trusted Interior &amp; Modular Kitchen Partner
            </h2>
            <p class="text-stone-600 text-sm sm:text-base leading-relaxed font-sans mt-3">
              AAICA Modular Kitchen (A Unit of R&amp;R Industries) is a premier East Delhi manufacturing firm specializing in precision modular kitchens and architectural joinery. With over 500+ delivered kitchens across Delhi NCR, our legacy is built on direct factory trust, authentic European hardware, and honest material pricing.
            </p>
          </div>

