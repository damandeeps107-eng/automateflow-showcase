        </div>
        <button onclick="closeInquiryModal()" class="text-stone-400 hover:text-white transition p-1 rounded-full hover:bg-white/10" aria-label="Close modal">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 sm:p-8">
        <div class="text-left mb-6">
          <h3 class="text-2xl sm:text-3xl font-heading font-black text-stone-900 leading-tight">
            Get Free 3D Design &amp; Direct Factory Quote
          </h3>
          <p class="text-xs sm:text-sm text-stone-600 mt-1.5 font-sans leading-relaxed">
            Save <strong>30–40% vs retail showrooms</strong>. Genuine 18mm IS:710 Marine Ply &amp; German fittings delivered directly from our East Delhi Atelier.
          </p>
        </div>

        <!-- Form -->
        <form id="popup-inquiry-form" onsubmit="handlePopupSubmit(event)" class="space-y-4">
          
          <div>
            <label class="block text-xs font-heading font-bold uppercase tracking-wider text-stone-700 mb-1.5">Your Name *</label>
            <input type="text" id="popup-name" required placeholder="e.g. Vikram Sharma" 
                   class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:border-[#8C7756] focus:ring-2 focus:ring-[#8C7756]/20 text-stone-900 text-sm transition outline-none">
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label class="block text-xs font-heading font-bold uppercase tracking-wider text-stone-700 mb-1.5">Phone / WhatsApp *</label>
              <input type="tel" id="popup-phone" required placeholder="+91 98XXX XXXXX" 
                     class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:border-[#8C7756] focus:ring-2 focus:ring-[#8C7756]/20 text-stone-900 text-sm transition outline-none">
            </div>
            <div>
              <label class="block text-xs font-heading font-bold uppercase tracking-wider text-stone-700 mb-1.5">Location / City *</label>
              <input type="text" id="popup-location" required placeholder="e.g. Preet Vihar, Delhi NCR" 
                     class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:border-[#8C7756] focus:ring-2 focus:ring-[#8C7756]/20 text-stone-900 text-sm transition outline-none">
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label class="block text-xs font-heading font-bold uppercase tracking-wider text-stone-700 mb-1.5">Kitchen Layout</label>
              <select id="popup-layout" class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:border-[#8C7756] focus:ring-2 focus:ring-[#8C7756]/20 text-stone-900 text-sm transition outline-none bg-white">
                <option value="L-Shaped Kitchen">L-Shaped Kitchen</option>
                <option value="U-Shaped Kitchen">U-Shaped Kitchen</option>
                <option value="Parallel / Galley Kitchen">Parallel / Galley Kitchen</option>
                <option value="Island Kitchen">Island Kitchen</option>
                <option value="Straight-Line Kitchen">Straight-Line Kitchen</option>
                <option value="Undecided / Need Advice">Undecided / Need Consultation</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-heading font-bold uppercase tracking-wider text-stone-700 mb-1.5">Project Stage</label>
              <select id="popup-stage" class="w-full px-4 py-3 rounded-xl border border-stone-300 focus:border-[#8C7756] focus:ring-2 focus:ring-[#8C7756]/20 text-stone-900 text-sm transition outline-none bg-white">
                <option value="Planning / Exploring Ideas">Planning / Exploring Ideas</option>
                <option value="Civil Work Underway">Civil Work Underway</option>
                <option value="Ready for Immediate Installation">Ready for Immediate Work</option>
              </select>
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit" 
                  class="w-full py-4 bg-[#8C7756] hover:bg-[#736145] text-white rounded-full font-heading font-bold text-sm uppercase tracking-wider shadow-xl hover:shadow-2xl transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2 mt-2">
            <span>Claim Free 3D Design &amp; Factory Quote</span>
            <span class="text-base">&rarr;</span>
          </button>
        </form>

        <!-- Trust Badges Under Form -->
        <div class="flex items-center justify-center gap-4 mt-4 pt-3 border-t border-stone-100 text-[11px] text-stone-500">
          <span class="flex items-center gap-1">🔒 100% Privacy</span>
          <span>•</span>
          <span class="flex items-center gap-1">📐 Free 3D CAD Blueprint</span>
          <span>•</span>
          <span class="flex items-center gap-1">🏭 Jagat Puri Atelier</span>
        </div>

      </div>

    </div>
  </div>


  <!-- Client-Side Scripts (Hero Slider, Minimal Estimator, Accordions, Modal, Mobile Nav) -->
  <script>
    // 1. Hero Woodspace Vertical Slider
    (function initHeroSlider() {
      const track = document.querySelector('.hero-slider .hero-track');
      const slides = document.querySelectorAll('.hero-slider .hero-slide');
      const dots = document.querySelectorAll('.hero-slider .hero-dot');
      if (!track || !slides.length) return;
      let currentSlide = 0;
      let timer = null;

      function goToSlide(idx) {
        currentSlide = idx;
        track.style.transform = `translateX(-${idx * 25}%)`;
        slides.forEach((s, i) => s.classList.toggle('active', i === idx));
        dots.forEach((d, i) => {
          if (i === idx) {
            d.className = 'hero-dot active w-7 h-2 rounded-full bg-amber-400 transition-all duration-300';
          } else {
            d.className = 'hero-dot w-2 h-2 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300';
          }
        });
      }

      function nextSlide() {
        let nxt = (currentSlide + 1) % slides.length;
        goToSlide(nxt);
      }

      function startAutoplay() {
        stopAutoplay();
        timer = setInterval(nextSlide, 5000);
      }

      function stopAutoplay() {
        if (timer) clearInterval(timer);
      }

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          goToSlide(idx);
          startAutoplay();
        });
      });

      const heroEl = document.querySelector('.hero-slider');
      if (heroEl) {
        heroEl.addEventListener('mouseenter', stopAutoplay);
        heroEl.addEventListener('mouseleave', startAutoplay);
      }

      startAutoplay();
    })();

    // 2. Mobile Menu Toggle
    (function initMobileMenu() {
      const toggle = document.getElementById('mobile-menu-toggle');
      const menu = document.getElementById('mobile-menu-dropdown') || document.getElementById('mobile-menu');
      const hamburger = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');
      if (!toggle || !menu) return;

      toggle.addEventListener('click', () => {
        const isHidden = menu.classList.contains('hidden');
        if (isHidden) {
          menu.classList.remove('hidden');
          if (hamburger) hamburger.classList.add('hidden');
          if (closeIcon) closeIcon.classList.remove('hidden');
        } else {
          menu.classList.add('hidden');
          if (hamburger) hamburger.classList.remove('hidden');
          if (closeIcon) closeIcon.classList.add('hidden');
        }
      });

      document.querySelectorAll('.mobile-nav-link').forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
          if (hamburger) hamburger.classList.remove('hidden');
          if (closeIcon) closeIcon.classList.add('hidden');
        });
      });
    })();

    // 3. FAQ Accordion
    document.querySelectorAll('.accordion-item button').forEach(button => {
      button.addEventListener('click', () => {
        const item = button.closest('.accordion-item');
        const isActive = item.classList.contains('active');
        document.querySelectorAll('.accordion-item').forEach(i => i.classList.remove('active'));
        if (!isActive) item.classList.add('active');
      });
    });

    // 4. Minimal Architectural Kitchen Estimator
    let calcState = {
      layoutId: 'l_shape',
      layoutName: 'L-Shaped Kitchen (8×10 ft)',
      baseMin: 185000,
      baseMax: 220000,
      layoutBadge: '8×10 ft Standard',
      finishId: 'acrylic',
      finishName: 'High-Gloss Acrylic (Senosan)',
      finishMult: 1.25,
      scaleId: 'standard',
      scaleMult: 1.0,
      scaleBadge: 'Standard (~22 Running Ft)'
    };

    function formatINR(val) {
      return val.toLocaleString('en-IN');
    }

    function updateKitchenEstimate() {
      const minCalc = Math.round((calcState.baseMin * calcState.finishMult * calcState.scaleMult) / 1000) * 1000;
      const maxCalc = Math.round((calcState.baseMax * calcState.finishMult * calcState.scaleMult) / 1000) * 1000;
      
      const retailMin = Math.round(minCalc * 1.6 / 1000) * 1000;
      const retailMax = Math.round(maxCalc * 1.6 / 1000) * 1000;

      const priceRangeEl = document.getElementById('calc-price-range');
      const retailPriceEl = document.getElementById('calc-retail-price');
      const waBtn = document.getElementById('calc-whatsapp-btn');

      if (priceRangeEl) {
        priceRangeEl.innerText = `${formatINR(minCalc)} – ${formatINR(maxCalc)}`;
      }
      if (retailPriceEl) {
        retailPriceEl.innerText = `₹${formatINR(retailMin)} – ₹${formatINR(retailMax)}`;
      }

      if (waBtn) {
        const msg = `Hi Arjun Ji, I used the AAICA Kitchen Estimator on your website:

` +
                    `• Layout: ${calcState.layoutName}
` +
                    `• Finish: ${calcState.finishName}
` +
                    `• Scale: ${calcState.scaleBadge}
` +
                    `• Direct Factory Estimate: ₹${formatINR(minCalc)} – ₹${formatINR(maxCalc)}

` +
                    `Please share the itemized BOQ & let me know when I can visit your Jagat Puri factory atelier.`;
        waBtn.href = `https://wa.me/919910270754?text=${encodeURIComponent(msg)}`;
      }
    }

    function setCalcLayout(id, name, min, max, badge) {
      calcState.layoutId = id;
      calcState.layoutName = name;
      calcState.baseMin = min;
      calcState.baseMax = max;
      calcState.layoutBadge = badge;

      document.querySelectorAll('.calc-layout-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      if (window.event && window.event.currentTarget) {
        window.event.currentTarget.classList.add('active');
      }
      const bEl = document.getElementById('calc-layout-badge');
      if (bEl) bEl.innerText = badge;
      updateKitchenEstimate();
    }

    function setCalcFinish(id, name, mult, desc) {
      calcState.finishId = id;
      calcState.finishName = name;
      calcState.finishMult = mult;

      document.querySelectorAll('.calc-finish-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      if (window.event && window.event.currentTarget) {
        window.event.currentTarget.classList.add('active');
      }
      const bEl = document.getElementById('calc-finish-badge');
      if (bEl) bEl.innerText = name;
      updateKitchenEstimate();
    }

    function setCalcScale(id, mult, badge) {
      calcState.scaleId = id;
      calcState.scaleMult = mult;
      calcState.scaleBadge = badge;

      document.querySelectorAll('.calc-scale-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      if (window.event && window.event.currentTarget) {
        window.event.currentTarget.classList.add('active');
      }
      const bEl = document.getElementById('calc-scale-badge');
      if (bEl) bEl.innerText = badge;
      updateKitchenEstimate();
    }

    // Run initial estimate
    updateKitchenEstimate();

    // 5. Luxury Modal & WhatsApp Lead Dispatchers
    function openInquiryModal() {
      const modal = document.getElementById('inquiry-modal');
      const content = document.getElementById('modal-content');
      if (!modal || !content) return;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      content.classList.remove('scale-95');
      content.classList.add('scale-100');
    }

    function closeInquiryModal() {
      const modal = document.getElementById('inquiry-modal');
      const content = document.getElementById('modal-content');
      if (!modal || !content) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      content.classList.remove('scale-100');
      content.classList.add('scale-95');
    }

    function handlePopupSubmit(e) {
      e.preventDefault();
      const name = document.getElementById('popup-name').value;
      const phone = document.getElementById('popup-phone').value;
      const loc = document.getElementById('popup-location').value;
      const layout = document.getElementById('popup-layout').value;
      const stage = document.getElementById('popup-stage').value;

      const msg = `Hi Arjun Ji, new inquiry via AAICA Website Free Quote Modal:

` +
                  `• Name: ${name}
` +
                  `• Phone: ${phone}
` +
                  `• Location: ${loc}
` +
                  `• Kitchen Layout: ${layout}
` +
                  `• Stage: ${stage}

` +
                  `Please arrange a free 3D CAD design consultation and factory-direct quote.`;

      window.open(`https://wa.me/919910270754?text=${encodeURIComponent(msg)}`, '_blank');
      closeInquiryModal();
      alert(`Thank you, ${name}! Your consultation request has been sent to Arjun Ji on WhatsApp.`);
    }

    function scrollTestimonialsTrack(direction) {
      const track = document.querySelector(".testimonials-slide-track");
      if (!track) return;
      // Temporarily toggle animation or shift
      const currentAnimation = track.style.animationPlayState;
      track.style.animation = "none";
      const shift = direction * 380;
      track.scrollLeft += shift;
      setTimeout(() => {
        track.style.animation = "testimonialSlide 38s linear infinite";
      }, 500);
    }

    function handleSectionFormSubmit(e) {
      e.preventDefault();
      const name = document.getElementById('sec-name').value;
      const phone = document.getElementById('sec-phone').value;
      const loc = document.getElementById('sec-loc').value;
      const layout = document.getElementById('sec-layout').value;
      const stage = document.getElementById('sec-stage').value || 'Planning';
      const notes = document.getElementById('sec-notes').value || 'Standard Inquiry';

      const msg = `Hi Arjun Ji, inquiry via AAICA Free Consultation Form:

` +
                  `• Name: ${name}
` +
                  `• Phone: ${phone}
` +
                  `• Location: ${loc}
` +
                  `• Preferred Layout: ${layout}
` +
                  `• Stage: ${stage}
` +
                  `• Requirements: ${notes}

` +
                  `Please schedule a site laser measurement & factory sample review.`;

      window.open(`https://wa.me/919910270754?text=${encodeURIComponent(msg)}`, '_blank');
      alert(`Thank you, ${name}! Your consultation request has been sent to Arjun Ji at AAICA Kitchen.`);
    }

    // Modal opens on button click (or subtle exit intent, never intrusive auto-block)
    // window.addEventListener('load', () => {});
  </script>

</body>
</html>
