        <div class="hero-slide-overlay"></div>
        <div class="hero-text-centered">
          <div class="anim-eyebrow text-amber-300 text-xs sm:text-sm font-heading font-extrabold tracking-[0.25em] uppercase mb-4">
            BESPOKE ERGONOMICS
          </div>
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-heading font-black text-white tracking-tight leading-[1.08] max-w-4xl mb-8">
            Design Spaces To<br> Make Wonderful Living
